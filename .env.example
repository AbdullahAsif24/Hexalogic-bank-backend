# ============================================================
# .env.example - COPY this file to ".env" and fill in real values
# (.env is git-ignored; .env.example is committed as documentation)
# ============================================================

# MySQL connection.
# Local development example:
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=bank_app
#   DB_PASSWORD=change_me
#   DB_NAME=BankDB
#   DB_SSL=false
#
# Aiven (or other cloud) example:
#   DB_HOST=mysql-xxxxx-yyyy.z.aivencloud.com
#   DB_PORT=27501
#   DB_USER=avnadmin
#   DB_PASSWORD=AVNS_xxxxxxxxxxxx
#   DB_NAME=defaultdb
#   DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=bank_app
DB_PASSWORD=change_me
DB_NAME=BankDB
DB_SSL=false

# Secret used to sign login tokens. Use a long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=put-a-long-random-string-here

# Port the Express API runs on
PORT=8000

# Browser origins that may call the API (comma separated), e.g.:
#   CORS_ORIGIN=https://hexalogic-bank.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
